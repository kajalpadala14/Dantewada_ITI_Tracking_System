# ==============================================================================
# Dantewada ITI Student Tracking System - Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your deployed Google Apps Script Web App URL:
#
# Deployment Steps:
# 1. Open your Google Sheet: Extensions > Apps Script
# 2. Paste the code from `google-apps-script.js` and click Save
# 3. Click Deploy > New deployment > Type: Web app
# 4. Set "Execute as: Me" and "Who has access: Anyone"
# 5. Copy the generated Web App URL and paste it below:

APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional alias (for Vite/Webpack toolchain compatibility)
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Local Server Port (Default: 3000)
PORT=3000
